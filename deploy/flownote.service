[Unit]
Description=FlowNote - private traffic self-service
After=network.target x-ui.service
Wants=x-ui.service

[Service]
User=flownote
Group=flownote
ExecStart=/usr/local/bin/flownote /etc/flownote/config.toml
Environment=RUST_LOG=warn
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
StateDirectory=flownote
StateDirectoryMode=0700
UMask=0077
MemoryMax=192M
TasksMax=256

[Install]
WantedBy=multi-user.target
